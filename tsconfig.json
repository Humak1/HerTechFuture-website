{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // `strict` turns on the full family of type-safety checks. Leave it on.
    // Every bug it catches at build time is a bug that never reaches the site.
    "strict": true,
    // Catches `array[10]` returning `undefined` when the array is shorter.
    "noUncheckedIndexedAccess": true,
    // Fails the build on an unused import or variable, which keeps the code tidy.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Lets you write `import { Button } from "@/components/ui/button"` from
    // anywhere instead of counting how many `../` you need.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
